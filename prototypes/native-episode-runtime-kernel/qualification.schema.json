{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haws.local/schemas/native-qualification-v0.1.json",
  "title": "Native Episode Qualification v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "parent_state_version_rebound", "evaluator_id", "mode", "claim_evaluated", "evidence_used", "checks", "failures", "verdict", "supported_claim", "parent_status_claim", "promotion_claim"],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "parent_state_version_rebound": {"type": "string", "minLength": 1},
    "evaluator_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["DETERMINISTIC", "SEPARATE_CONTEXT", "INDEPENDENT", "RECIPIENT_USE"]},
    "claim_evaluated": {"type": "string", "minLength": 1},
    "evidence_used": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verdict": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
    "supported_claim": {"type": "string", "minLength": 1},
    "parent_status_claim": {"type": ["string", "null"]},
    "promotion_claim": {"const": false}
  }
}

